---
// Redirects from the old GitHub Pages URLs (/hedy-diario/ and /hedy-diario/blog/<post>/).
import { getCollection } from 'astro:content';
import Redirect from '../../components/Redirect.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return [
		{ params: { path: undefined }, props: { to: '/' } },
		...posts.map((post) => ({ params: { path: `blog/${post.id}` }, props: { to: `/${post.id}/` } })),
	];
}
---

<Redirect to={Astro.props.to} />
