---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../layouts/BlogPost.astro';
import { PILARES, getGrafo } from '../lib/grafo';
import { getPosts } from '../lib/posts';

export async function getStaticPaths() {
	const { mencionadoEn, seguirLeyendo } = await getGrafo();
	const resumen = new Map((await getPosts()).map((p) => [p.id, p]));
	const conFecha = (l: { id: string; title: string }[]) =>
		l.map((x) => ({ ...x, pubDate: resumen.get(x.id)!.pubDate }));
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: {
			...post,
			mencionadoEn: conFecha(mencionadoEn(post.id)),
			related: conFecha(seguirLeyendo(post.id)),
			pilar: { clave: resumen.get(post.id)!.pilar, ...PILARES[resumen.get(post.id)!.pilar] },
			minutos: resumen.get(post.id)!.minutos,
		},
	}));
}
type Enlace = { id: string; title: string; pubDate: Date };
type Props = CollectionEntry<'blog'> & {
	related: Enlace[];
	mencionadoEn: Enlace[];
	pilar: { clave: string; nombre: string; color: string };
	minutos: number;
};

const { related, mencionadoEn, pilar, minutos, ...post } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} related={related} mencionadoEn={mencionadoEn} pilar={pilar} minutos={minutos}>
	<Content />
</BlogPost>
