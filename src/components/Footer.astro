---
import Brote from './Brote.astro';

const today = new Date();
---

<footer>
	<Brote size={30} />
	<nav class="start" aria-label="Empieza aquí">
		<strong>Empieza aquí:</strong>
		<a href="/2026-09-23-jardines-digitales-por-que-existen-blogs-personales/">Jardines digitales</a>
		<a href="/2026-09-22-origen-de-la-tecnica-pomodoro/">Origen de Pomodoro</a>
		<a href="/2026-09-20-mentalidad-de-principiante-beginners-mind/">Mente de principiante</a>
	</nav>
	<nav class="links" aria-label="Páginas del sitio">
		<a href="/archivo/">Archivo</a>
		<a href="/jardin/">Jardín digital</a>
		<a href="/acerca/">Acerca de</a>
		<a href="/privacidad/">Privacidad</a>
