<style>
	footer {
		margin-top: 2rem;
		padding: 2.5rem 1.5rem 5rem;
		border-top: 1.5px solid var(--line);
		background: color-mix(in srgb, var(--paper) 60%, transparent);
		color: var(--muted);
		text-align: center;
		font-size: 0.9rem;
	}
	footer p {
		margin: 0;
	}
	.start,
	.links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.25em 1.25em;
		margin: 0.9rem 0;
	}
	footer a {
		color: var(--muted);
	}
	footer a:hover {
		color: var(--ink);
	}
</style>
