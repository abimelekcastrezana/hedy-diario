---
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href={import.meta.env.BASE_URL}>{SITE_TITLE}</a></h2>
		<a class="about" href="/acerca/">Acerca de</a>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	.about {
		font-size: 0.85em;
		text-decoration: none;
		color: rgb(var(--gray));
	}
	.about:hover {
		color: rgb(var(--gray-dark));
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.5em 0;
	}
</style>
