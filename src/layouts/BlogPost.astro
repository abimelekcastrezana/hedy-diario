---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & {
	related?: { id: string; title: string }[];
	mencionadoEn?: { id: string; title: string }[];
};

const { title, description, pubDate, updatedDate, related = [], mencionadoEn = [] } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
// Structured data so search engines can show the post as an article.
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	inLanguage: 'es',
	url,
	mainEntityOfPage: url,
	image: new URL(FallbackImage.src, Astro.site).href,
	author: { '@type': 'Organization', name: SITE_TITLE, url: Astro.site?.href },
	publisher: { '@type': 'Organization', name: SITE_TITLE, url: Astro.site?.href },
};
---

<html lang="es">
	<head>
		<BaseHead title={title} description={description} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.follow {
				margin-top: 3em;
				padding: 1em 1.25em;
				border-radius: 8px;
				background: rgb(var(--gray-light));
			}
			.follow h2 {
				margin: 0 0 0.25em 0;
			}
			.follow p {
				margin: 0;
				font-size: 0.9em;
			}
			.related {
				margin-top: 3em;
				padding-top: 1em;
				border-top: 1px solid rgb(var(--gray-light));
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Actualizado el <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
					<aside class="follow">
						<h2>Sigue a Hedy</h2>
						<p>
							¿Quieres leer el próximo post sin buscarlo? Suscríbete por <a href="/rss.xml">RSS</a>: es un
							enlace que tu lector de noticias (como Feedly, Inoreader o NetNewsWire) revisa por ti. No
							necesitas dar tu correo. <a href="/acerca/">Conoce más sobre Hedy</a>.
						</p>
					</aside>
					{
						mencionadoEn.length > 0 && (
							<section class="related">
								<h2>Se menciona en</h2>
								<ul>
									{mencionadoEn.map((post) => (
										<li>
											<a href={`/${post.id}/`}>{post.title}</a>
										</li>
									))}
								</ul>
							</section>
						)
					}
					{
						related.length > 0 && (
							<section class="related">
								<h2>Sigue leyendo</h2>
								<ul>
									{related.map((post) => (
										<li>
											<a href={`/${post.id}/`}>{post.title}</a>
										</li>
									))}
								</ul>
							</section>
						)
					}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
