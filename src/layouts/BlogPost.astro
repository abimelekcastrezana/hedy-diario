---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';

type Enlace = { id: string; title: string; pubDate: Date };
type Props = CollectionEntry<'blog'>['data'] & {
	related?: Enlace[];
	mencionadoEn?: Enlace[];
	pilar?: { clave: string; nombre: string; color: string };
	minutos?: number;
};

const { title, description, pubDate, updatedDate, related = [], mencionadoEn = [], pilar, minutos } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
// Structured data so search engines can show the post as an article.
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	inLanguage: 'es',
	url,
	mainEntityOfPage: url,
	image: new URL(FallbackImage.src, Astro.site).href,
	author: { '@type': 'Organization', name: SITE_TITLE, url: Astro.site?.href },
	publisher: { '@type': 'Organization', name: SITE_TITLE, url: Astro.site?.href },
};
---

<html lang="es">
	<head>
		<BaseHead title={title} description={description} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<style>
			.cabecera {
				margin-bottom: 2.2rem;
				padding-bottom: 1.8rem;
				border-bottom: 1.5px solid var(--line);
			}
			.fecha {
				margin: 0 0 0.6rem;
				font-size: 0.8rem;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: var(--muted);
			}
			.fecha em {
				display: block;
				margin-top: 0.2rem;
				text-transform: none;
				letter-spacing: 0;
			}
			.cabecera h1 {
				margin: 0 0 0.8rem;
				font-size: 2.5rem;
				line-height: 1.15;
			}
			.subtitulo {
				margin: 0 0 1.2rem;
				font-family: var(--font-titulo);
				font-style: italic;
				font-size: 1.15rem;
				line-height: 1.5;
				color: var(--muted);
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.5rem 0.9rem;
				font-size: 0.85rem;
				color: var(--muted);
			}
			.follow {
				margin-top: 3rem;
				padding: 1.1rem 1.4rem;
				border-radius: var(--radius);
				background: var(--sticky);
				color: var(--ink);
				box-shadow: var(--shadow);
				transform: rotate(-0.4deg);
			}
			.follow h2 {
				margin: 0 0 0.3rem 0;
				padding: 0;
				border: 0;
				font-size: 1.15rem;
				color: var(--ink);
			}
			.follow p {
				margin: 0;
				font-size: 0.9rem;
				line-height: 1.6;
			}
			.follow a {
				color: var(--ink);
			}
			.related {
				margin-top: 3rem;
			}
			.related h2 {
				margin: 0 0 1rem;
				padding: 0 0 0.7rem;
				font-family: var(--font-texto);
				font-size: 0.8rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--muted);
			}
			.related ul {
				margin: 0;
			}
			.related li {
				padding: 0 0 1rem;
				margin: 0;
			}
			.related li::before {
				display: none;
			}
			.related a {
				font-family: var(--font-titulo);
				font-size: 1.15rem;
				font-weight: 600;
				line-height: 1.3;
				color: var(--ink);
				text-decoration: none;
			}
			.related a:hover {
				color: var(--accent);
				text-decoration: underline;
			}
			.related small {
				display: block;
				font-size: 0.8rem;
				color: var(--muted);
			}
			@media (max-width: 560px) {
				.cabecera h1 {
					font-size: 2rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="prose">
					<header class="cabecera">
						<p class="fecha">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<em>
										Actualizado el <FormattedDate date={updatedDate} />
									</em>
								)
							}
						</p>
						<h1>{title}</h1>
						<p class="subtitulo">{description}</p>
						<div class="meta">
							{
								pilar && (
									<a class="pilar" href={`/archivo/#${pilar.clave}`}>
										<i style={`background:${pilar.color}`} />
										{pilar.nombre}
									</a>
								)
							}
							{minutos && <span>{minutos} min de lectura</span>}
						</div>
					</header>
					<slot />
					<aside class="follow">
						<h2>Sigue a Hedy</h2>
						<p>
							¿Quieres leer el próximo post sin buscarlo? Suscríbete por <a href="/rss.xml">RSS</a>: es un
							enlace que tu lector de noticias (como Feedly, Inoreader o NetNewsWire) revisa por ti. No
							necesitas dar tu correo. <a href="/acerca/">Conoce más sobre Hedy</a>.
						</p>
					</aside>
					{
						mencionadoEn.length > 0 && (
							<section class="related">
								<h2>Se menciona en</h2>
								<ul>
									{mencionadoEn.map((post) => (
										<li>
											<a href={`/${post.id}/`}>{post.title}</a>
											<small>
												<FormattedDate date={post.pubDate} />
											</small>
										</li>
									))}
								</ul>
							</section>
						)
					}
					{
						related.length > 0 && (
							<section class="related">
								<h2>Sigue leyendo</h2>
								<ul>
									{related.map((post) => (
										<li>
											<a href={`/${post.id}/`}>{post.title}</a>
											<small>
												<FormattedDate date={post.pubDate} />
											</small>
										</li>
									))}
								</ul>
							</section>
						)
					}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
